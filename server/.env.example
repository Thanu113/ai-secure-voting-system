# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/ai_voting_system

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_min_32_chars_long_12345
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_min_32_chars_long_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Machine Learning Service URL
ML_SERVICE_URL=http://localhost:8000

# Nodemailer / Email OTP (Use ethereal or real SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user@ethereal.email
SMTP_PASS=your_ethereal_password
EMAIL_FROM="AI Secure Voting System <noreply@securevote.org>"

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

